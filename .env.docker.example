# Copy to .env.docker. Never commit real secrets.
# Use strong URL-safe DB_PASSWORD and DB_ROOT_PASSWORD values, no @/#/:%.
DB_ROOT_PASSWORD=REPLACE_WITH_STRONG_ROOT_PASSWORD
DB_PASSWORD=REPLACE_WITH_STRONG_APP_PASSWORD
# In PowerShell: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=REPLACE_WITH_A_64_CHARACTER_RANDOM_HEX_SECRET
